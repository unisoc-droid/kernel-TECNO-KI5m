# SPDX-License-Identifier: GPL-2.0
# UMS9230/qogirl6 SoC Platform Configuration
# Shared across all UMS9230 devices

# Clock/Reset
CONFIG_SPRD_COMMON_CLK=m
CONFIG_SPRD_UMS9230_CLK=m
CONFIG_HWSPINLOCK_SPRD=m
CONFIG_PINCTRL_SPRD=m
CONFIG_PINCTRL_SPRD_QOGIRL6=m
CONFIG_GPIO_SPRD=m
CONFIG_GPIO_EIC_SPRD=m
CONFIG_SPI_SPRD_ADI=m

# PMIC/Regulator
CONFIG_MFD_SC27XX_PMIC=m
CONFIG_REGULATOR_SC2730=m
CONFIG_GPIO_PMIC_EIC_SPRD=m

# SoC ID / SIP
CONFIG_SPRD_SOCID=m
CONFIG_SPRD_SIP_FW=m
CONFIG_RPMB_INTF_DEV=m
CONFIG_SCSI_UFS_SPRD=m

# Trusty
CONFIG_TRUSTY=m
CONFIG_TRUSTY_LOG=m
CONFIG_TRUSTY_VIRTIO=m
CONFIG_TRUSTY_VIRTIO_IPC=m
CONFIG_SPRD_TSHM=m

# Thermal
CONFIG_SPRD_THERMAL=m
CONFIG_UNISOC_SOC_THERMAL=m
CONFIG_SC27XX_TSENSOR_THERMAL=m

# I2C Core (built-in for early drivers)
CONFIG_I2C=y
CONFIG_I2C_SPRD=m

# Watchdog
CONFIG_SPRD_WATCHDOG_FIQ=m

# Unisoc Platform Drivers
CONFIG_UNISOC_THERMAL=m
CONFIG_UNISOC_IOMMU=y
CONFIG_UNISOC_DMABUF=y

# Platform Debug/Monitoring
CONFIG_UNISOC_LASTKMSG=m
CONFIG_UNISOC_MAILBOX=m
CONFIG_UNISOC_MAPUSER=m
CONFIG_UNISOC_MM_ENHANCE_MEMINFO=m
CONFIG_UNISOC_MM_RECLAIM=m
CONFIG_UNISOC_SCHED=m
CONFIG_UNISOC_SCHEDUTIL_GOV=m
CONFIG_UNISOC_THERMAL_CTL=m