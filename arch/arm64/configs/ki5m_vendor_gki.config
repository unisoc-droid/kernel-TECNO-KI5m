# SPDX-License-Identifier: GPL-2.0
# KI5m GKI vendor-module fragment (layered on gki_defconfig).
#
# Pure GKI split:
#   - boot Image = gki_defconfig only. Only GKI bools are enabled here
#     (ARCH_SPRD, I2C, ION, SERIAL_SPRD console) — no vendor driver code.
#   - all vendor drivers are =m and land in vendor_dlkm / vendor_boot ramdisk.
#   - DPU0/DSI are bool under "if UNISOC_DISP"; with parent =m their objects
#     are linked into sprd_drm.ko, not vmlinux.

# Platform select (bool, no driver code).
CONFIG_ARCH_SPRD=y

# Early console (SERIAL_SPRD itself is already =y in gki_defconfig).
CONFIG_SERIAL_SPRD_CONSOLE=y

# Core buses needed by modules (bool, GKI-standard).
CONFIG_I2C=y
CONFIG_ION=y

# Clocks / pinctrl / GPIO / SPI / PMIC / regulator.
CONFIG_SPRD_COMMON_CLK=m
CONFIG_SPRD_UMS9230_CLK=m
CONFIG_HWSPINLOCK_SPRD=m
CONFIG_PINCTRL_SPRD=m
CONFIG_PINCTRL_SPRD_QOGIRL6=m
CONFIG_GPIO_SPRD=m
CONFIG_GPIO_EIC_SPRD=m
CONFIG_GPIO_PMIC_EIC_SPRD=m
CONFIG_SPI_SPRD_ADI=m
CONFIG_MFD_SC27XX_PMIC=m
CONFIG_REGULATOR_SC2730=m

# SoC ID / SIP / RPMB / storage / watchdog.
CONFIG_SPRD_SOCID=m
CONFIG_SPRD_SIP_FW=m
CONFIG_RPMB_INTF_DEV=m
CONFIG_SCSI_UFS_SPRD=m
CONFIG_SPRD_WATCHDOG_FIQ=m

# Trusty (KeyMint / Gatekeeper / RPMB transport).
CONFIG_TRUSTY=m
CONFIG_TRUSTY_LOG=m
CONFIG_TRUSTY_VIRTIO=m
CONFIG_TRUSTY_VIRTIO_IPC=m
CONFIG_SPRD_TSHM=m
# CONFIG_TRUSTY_TUI is not set

# Thermal.
CONFIG_SPRD_CACHE_EFUSE=m
CONFIG_SC27XX_EFUSE=m
CONFIG_SPRD_THERMAL=m
CONFIG_UNISOC_SOC_THERMAL=m
CONFIG_SC27XX_TSENSOR_THERMAL=m

# I2C LCD bias controller.
CONFIG_TRANSSION_BIAS_VOLTAGE=m

# ION allocation (core is GKI bool; heaps and SPRD driver are modules).
CONFIG_ION_SYSTEM_HEAP=m
CONFIG_ION_CMA_HEAP=m
CONFIG_ION_SPRD=m

# Display / GPU pipeline as modules.
CONFIG_UNISOC_DISP=m
CONFIG_DRM_SPRD_DPU0=y
CONFIG_DRM_SPRD_DSI=y
CONFIG_UNISOC_GSP=m
CONFIG_UNISOC_IOMMU=m
CONFIG_UNISOC_DMABUF=m

# Platform debug / monitoring as modules.
CONFIG_UNISOC_LASTKMSG=m
CONFIG_UNISOC_MAILBOX=m
CONFIG_UNISOC_MAPUSER=m
CONFIG_UNISOC_MM_ENHANCE_MEMINFO=m
CONFIG_UNISOC_MM_RECLAIM=m
CONFIG_UNISOC_SCHED=m
CONFIG_UNISOC_SCHEDUTIL_GOV=m
CONFIG_UNISOC_THERMAL=m
CONFIG_UNISOC_THERMAL_CTL=m
