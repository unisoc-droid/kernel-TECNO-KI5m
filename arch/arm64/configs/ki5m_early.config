# Core facilities for the KI5m boot and logical partitions.
CONFIG_ARCH_SPRD=y
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_LZ4=y
CONFIG_SERIAL_SPRD=y
CONFIG_SERIAL_SPRD_CONSOLE=y
CONFIG_DM_USER=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_MODULE_SIG_ALL=y

# UMS9230 and SC2730 providers used by the vendor ramdisk.
CONFIG_SPRD_COMMON_CLK=m
CONFIG_SPRD_UMS9230_CLK=m
CONFIG_HWSPINLOCK_SPRD=m
CONFIG_PINCTRL_SPRD=m
CONFIG_PINCTRL_SPRD_QOGIRL6=m
CONFIG_GPIO_SPRD=m
CONFIG_GPIO_EIC_SPRD=m
CONFIG_SPI_SPRD_ADI=m
CONFIG_MFD_SC27XX_PMIC=m
CONFIG_REGULATOR_SC2730=m
CONFIG_GPIO_PMIC_EIC_SPRD=m
CONFIG_SPRD_SOCID=m
CONFIG_SPRD_SIP_FW=m
CONFIG_RPMB_INTF_DEV=m
CONFIG_SCSI_UFS_SPRD=m

# Keep the Trusty transport available for stock KeyMint, Gatekeeper and RPMB userspace.
CONFIG_TRUSTY=y
CONFIG_TRUSTY_LOG=m
CONFIG_TRUSTY_VIRTIO=m
CONFIG_TRUSTY_VIRTIO_IPC=m
CONFIG_SPRD_TSHM=m
# CONFIG_TRUSTY_TUI is not set

CONFIG_SPRD_WATCHDOG_FIQ=m

# Calibrated SoC and SC2730 temperature sensors for second-stage init.
CONFIG_SPRD_CACHE_EFUSE=m
CONFIG_SC27XX_EFUSE=m
CONFIG_SPRD_THERMAL=m
CONFIG_UNISOC_SOC_THERMAL=m
CONFIG_SC27XX_TSENSOR_THERMAL=m

# Native OCP2131 LCD bias controller (TASK 0M).
# I2C core + Spreadtrum I2C controller are required by TRANSSION_BIAS_VOLTAGE
# (depends on I2C) and by the &i2c5 bias_i2c@3e bus (sprd,sc9860-i2c fallback).
CONFIG_I2C=y
CONFIG_I2C_SPRD=y
CONFIG_TRANSSION_BIAS_VOLTAGE=y

# Legacy ION allocator for gralloc 4.0 (Android 13) — TASK 0M.8.
# ION is a bool (depends HAS_DMA && MMU). The heaps and the SPRD driver are
# tristate but built-in here so /dev/ion and /dev/sprd_ion exist at first-stage
# init before modules load.
CONFIG_ION=y
CONFIG_ION_SYSTEM_HEAP=y
CONFIG_ION_CMA_HEAP=y
CONFIG_ION_SPRD=y

# Unisoc vendor DRM/display pipeline — TASK 0M.8.
# UNISOC_DISP is tristate (depends ARCH_SPRD && DRM && OF). DPU0/DSI are bool
# under "if UNISOC_DISP"; DSI depends on DPU0. All =y so the panel object links
# into the same built-in image as TRANSSION_BIAS_VOLTAGE (see link constraint).
CONFIG_UNISOC_DISP=y
CONFIG_DRM_SPRD_DPU0=y
CONFIG_DRM_SPRD_DSI=y
CONFIG_UNISOC_GSP=y

# Unisoc IOMMU (used by sprd_crtc/gsp) and DMA-BUF heap provider — TASK 0M.8.
CONFIG_UNISOC_IOMMU=y
CONFIG_UNISOC_DMABUF=y